# Icarus Backend Environment Configuration

# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/icarus
DB_HOST=localhost
DB_PORT=5432
DB_NAME=icarus
DB_USER=user
DB_PASSWORD=password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=24h

# 2FA Configuration
TOTP_ISSUER=Icarus

# Security
BCRYPT_ROUNDS=12

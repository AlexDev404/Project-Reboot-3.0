  "description": "Native Node.js add-on for Icarus - C++ bindings for Project Reboot",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "install": "node-gyp rebuild",
    "build": "node-gyp rebuild && tsc",
